APIFY_API_TOKEN=
HUNTER_API_KEY=
NEVERBOUNCE_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# AGENT_DB_PATH defaults to backend/.data/agent.sqlite3
# WORKSPACE_DB_PATH defaults to backend/.data/workspace.sqlite3
# The blank GenMantis production project; use its publishable key (never a service-role key).
SUPABASE_URL=https://cpuhytycdbthpqvevjmc.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Set false for deployed environments. Docker sets this to false.
ALLOW_LOCAL_WORKSPACE=true
RESEARCH_MAX_CALLS=60

MAX_VERIFICATION_ATTEMPTS_PER_BUSINESS=4
MAX_HUNTER_RESULTS_PER_DOMAIN=10
MAX_HUNTER_PAGES_PER_DOMAIN=1
ENRICHMENT_CONCURRENCY=3
PROVIDER_MAX_RETRIES=2
PROVIDER_MIN_INTERVAL_SECONDS=0.25
MAX_ACTIVE_RUNS=1
MAX_STORED_RUNS=20
RUN_RETENTION_SECONDS=3600
APIFY_POLL_INTERVAL_SECONDS=3
APIFY_WAIT_TIMEOUT_SECONDS=3600
